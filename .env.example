# Copy to .env (it is git-ignored). Everything here is optional.

# Ollama on this machine answers first and needs no key. Install it, then: ollama pull llama3.2:3b
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:3b

# Free-tier fallbacks. Create the keys without adding billing, so they can never charge you.
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Order to try them in. Providers without a key are skipped.
# LLM_PROVIDERS=ollama,gemini,groq

# DATABASE_URL=postgres://streamrag:streamrag@localhost:5432/streamrag

# npm run upgrade reads older release notes from GitHub's API: 60 requests an hour without a token.
# A fine-grained token with no extra permissions (public repos only) raises that to 5,000.
# GITHUB_TOKEN=

# npm run pipeline. These match docker-compose.yml.
# KAFKA_BROKERS=localhost:19092
# REDIS_URL=redis://localhost:6379
# Optional Slack or Discord incoming webhook for new security advisories.
# ALERT_WEBHOOK_URL=

# npm run transcribe. Whisper runs locally; whisper-base (no .en) handles other languages.
# WHISPER_MODEL=Xenova/whisper-base.en
# FFMPEG_PATH=ffmpeg

# Observability (docker compose --profile observability up -d). Traces go to Jaeger; metrics are
# always served at the API's /metrics and on the pipeline's port below.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# PIPELINE_METRICS_PORT=9465
# Model calls to Langfuse (docker compose --profile langfuse up -d). These keys are the ones the
# compose file creates for its local instance; Langfuse Cloud's free tier works with its own keys.
# LANGFUSE_PUBLIC_KEY=pk-lf-streamrag-local
# LANGFUSE_SECRET_KEY=sk-lf-streamrag-local
# LANGFUSE_BASE_URL=http://localhost:3030
