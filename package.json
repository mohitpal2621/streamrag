{
  "name": "streamrag",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time RAG engine: streaming ingestion, hybrid search and AI agents over a live, always-fresh knowledge base.",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "ingest": "node --env-file-if-exists=.env src/cli.ts ingest",
    "search": "node --env-file-if-exists=.env src/cli.ts search",
    "ask": "node --env-file-if-exists=.env src/cli.ts ask",
    "agent": "node --env-file-if-exists=.env src/cli.ts agent",
    "serve": "node --env-file-if-exists=.env src/serve.ts",
    "mcp": "node --env-file-if-exists=.env src/mcp.ts",
    "upgrade": "node --env-file-if-exists=.env src/cli.ts upgrade",
    "usage": "node --env-file-if-exists=.env src/cli.ts usage",
    "track": "node --env-file-if-exists=.env src/cli.ts track",
    "eval": "node --env-file-if-exists=.env src/eval.ts",
    "eval:llm": "node eval/llm/setup.ts && node --env-file-if-exists=.env eval/llm/run.ts",
    "pipeline": "node --env-file-if-exists=.env src/pipeline/run.ts",
    "status": "node --env-file-if-exists=.env src/cli.ts status",
    "alerts": "node --env-file-if-exists=.env src/cli.ts alerts",
    "dlq": "node --env-file-if-exists=.env src/cli.ts dlq",
    "transcribe": "node --env-file-if-exists=.env src/cli.ts transcribe",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@platformatic/kafka": "^2.14.0",
    "bullmq": "^6.3.17",
    "fast-xml-parser": "^5.11.2",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.6",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@testcontainers/redpanda": "^12.2.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
