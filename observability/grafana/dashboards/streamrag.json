        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Events each Kafka consumer group has not handled yet; dlq is dead letters not replayed."
    },
    {
      "type": "timeseries",
