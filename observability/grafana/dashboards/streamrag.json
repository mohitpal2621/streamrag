      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (consumer, outcome) (rate(streamrag_events_handled_total[5m])) * 60",
          "legendFormat": "{{consumer}} {{outcome}}"
